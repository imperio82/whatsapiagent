// Atiendo IA - CRM multi-tenant por WhatsApp
// Schema modelo: todas las entidades de negocio incluyen tenantId
// para aislamiento por negocio. RBAC granular con permisos por recurso.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// PLATAFORMA (sin tenantId — globales)
// ============================================================================

model Tenant {
  id                       String         @id @default(cuid())
  slug                     String         @unique
  name                     String
  industry                 String?
  address                  String?
  taxId                    String?
  description              String?
  status                   TenantStatus   @default(ACTIVE)
  aiAutoReply              Boolean        @default(false)
  aiAgentName              String?
  // Segundos que el agente espera sin mensajes nuevos antes de responder (null: AI_REPLY_DELAY_MS del servidor)
  aiReplyDelaySec          Int?
  // Entrenar mi agente: cargo o rol con el que se presenta y su personalidad (aplica a tienda e intermediación)
  aiAgentRole              String?
  aiPersonality            String?
  // Permisos del agente por área { catalog, clients, orders, leads, appointments }: none, read, update o write.
  // Sin configurar = acceso completo (ver agent-permissions.ts)
  aiPermissions            Json?
  // Tipo de agente: tienda (catálogo y pedidos) o intermediación (inventario de bienes, calificación y citas)
  agentProfile             AgentProfile   @default(RETAIL)
  // Número (solo dígitos, con indicativo) al que la IA avisa compradores calientes, ofertas, citas y bienes nuevos
  ownerNotifyPhone         String?
  // Cuándo se cargaron las reglas por defecto; si el negocio las borra todas, no vuelven a aparecer
  aiRulesSeededAt          DateTime?
  // Coincidencias inventario ↔ compradores: el asesor aprueba cada mensaje (APPROVAL) o salen solos (AUTO)
  matchAlertMode           MatchAlertMode @default(APPROVAL)
  // Asistente del asesor: los mensajes que llegan desde el WhatsApp de un asesor (o del número de avisos) los atiende
  // un asistente interno (agenda, compradores, inventario) en vez del agente de clientes
  advisorAssistant         Boolean        @default(true)
  // Felicitaciones de cumpleaños y fechas especiales: mismo esquema que las coincidencias
  greetingMode             MatchAlertMode @default(APPROVAL)
  // Plantillas propias por tipo de fecha { BIRTHDAY, BIRTHDAY_OTHER, ANNIVERSARY, CUSTOM }; si falta, se usa la de fábrica
  greetingTemplates        Json?
  // Recordatorios de citas: cuántas horas antes se le escribe al cliente y si sale solo o con aprobación
  appointmentReminders     Boolean        @default(true)
  appointmentReminderHours Int            @default(24)
  appointmentReminderMode  MatchAlertMode @default(APPROVAL)
  // Seguimiento: si el cliente no responde en estas horas, se le vuelve a escribir (una vez por silencio)
  followUpEnabled          Boolean        @default(true)
  followUpHours            Int            @default(20)
  followUpMode             MatchAlertMode @default(APPROVAL)
  // Mensajes propios { APPOINTMENT, FOLLOW_UP }; si falta, se usa el de fábrica
  reminderTemplates        Json?
  // Contexto que usa el agente de IA para responder (texto libre que escribe el negocio)
  businessHours            String? // horario de atención
  deliveryInfo             String? // envíos, cobertura, costos y tiempos
  paymentInfo              String? // medios de pago
  faq                      String? // preguntas frecuentes, políticas de cambios y garantías
  // Consecutivo de pedidos (se incrementa dentro de la transacción)
  orderSeq                 Int            @default(0)
  // Consecutivo de bienes del inventario (INV-0001)
  listingSeq               Int            @default(0)
  // Plan contratado y hasta cuándo está pago (null: nunca ha pagado)
  plan                     PlanTier       @default(EMPRENDE)
  paidUntil                DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  memberships     Membership[]
  roles           Role[]
  products        Product[]
  templates       MessageTemplate[]
  clients         Client[]
  leads           Lead[]
  orders          Order[]
  conversations   Conversation[]
  whatsappAccount WhatsappAccount?
  aiRules         AiRule[]
  listings        Listing[]
  appointments    Appointment[]
  listingMatches  ListingMatch[]
  integrations    Integration[]
  integrationApps IntegrationApp[]
  dataSources     DataSource[]
  clientDates     ClientDate[]
  clientRelations ClientRelation[]
  greetings       Greeting[]
  reminders       Reminder[]
  billingEntries  BillingEntry[]
  agentVoice      AgentVoice?
  clonedVoices    ClonedVoice[]
  voiceClips      VoiceClip[]

  @@map("tenants")
}

// Planes que se venden; precios, cupos y presupuesto de IA viven en src/modules/billing/domain/plans.ts
enum PlanTier {
  EMPRENDE
  PRO
  NEGOCIO
}

// Movimientos de cobro que registra el administrador de la plataforma
model BillingEntry {
  id             String      @id @default(cuid())
  tenantId       String
  kind           BillingKind
  // PAYMENT: lo que pagó en pesos y cuántos meses cubre
  amountCop      Int?
  months         Int?
  // CREDIT: dólares de IA que se suman al presupuesto del mes en que se dan
  creditMicroUsd Int?
  note           String?
  createdById    String?
  createdAt      DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("billing_entries")
}

enum BillingKind {
  PAYMENT
  CREDIT
}

enum MatchAlertMode {
  APPROVAL // se le propone al asesor y él decide si se envía
  AUTO // se envía solo, en horario hábil y con límite por cliente
}

enum AgentProfile {
  RETAIL // tienda: catálogo, cotización y pedidos
  BROKERAGE // intermediación de vehículos e inmuebles
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

// Usuario global de la plataforma — puede pertenecer a varios tenants
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  passwordHash    String
  avatarUrl       String?
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships          Membership[]
  integrations         Integration[]
  assignedAppointments Appointment[] @relation("AssignedAppointments")

  @@map("users")
}

// Relación N:M User<->Tenant con rol(es) por tenant
model Membership {
  id            String           @id @default(cuid())
  userId        String
  tenantId      String
  status        MembershipStatus @default(ACTIVE)
  // WhatsApp del asesor (solo dígitos, con indicativo): desde ese número habla con el asistente del asesor
  whatsappPhone String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles  MembershipRole[]

  @@unique([userId, tenantId])
  @@unique([tenantId, whatsappPhone])
  @@index([tenantId])
  @@map("memberships")
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

// ============================================================================
// RBAC
// ============================================================================

model Role {
  id          String   @id @default(cuid())
  tenantId    String? // null = rol del sistema, no editable
  key         String // ej: "owner", "admin", "agent", "viewer"
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id        String   @id @default(cuid())
  key       String   @unique // ej: "products.create", "orders.update"
  resource  String // "products", "orders", ...
  action    String // "create", "read", "update", "delete", "manage"
  createdAt DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String
  roleId       String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

// ============================================================================
// PRODUCTOS / CATÁLOGO
// ============================================================================

model Product {
  id             String        @id @default(cuid())
  tenantId       String
  sku            String?
  name           String
  description    String?
  priceCents     Int // siempre en centavos, evita float
  currency       String        @default("COP")
  trackInventory Boolean       @default(true)
  stock          Int           @default(0)
  imageUrl       String?
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@map("products")
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

// ============================================================================
// CLIENTES / LEADS (CRM)
// ============================================================================

model Client {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String // E.164
  email     String?
  address   String?
  city      String?
  notes     String?
  // Memoria del agente de IA: preferencias y datos que el cliente contó (tallas, colores, otra dirección…)
  aiMemory  String?
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads           Lead[]
  orders          Order[]
  conversations   Conversation[]
  appointments    Appointment[]
  // Fechas especiales (suyas o de su gente), su red de contactos y las felicitaciones enviadas
  dates           ClientDate[]
  relations       ClientRelation[] @relation("ClientRelations")
  relatedTo       ClientRelation[] @relation("ClientRelatedTo")
  greetings       Greeting[]
  reminders       Reminder[]
  // El cliente pidió no recibir felicitaciones ni mensajes de fechas especiales
  greetingsOptOut Boolean          @default(false)

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("clients")
}

model Lead {
  id              String            @id @default(cuid())
  tenantId        String
  clientId        String?
  contactName     String
  businessName    String?
  phone           String
  address         String?
  industry        String?
  productInterest String?
  reasonNotBought String?
  stage           LeadStage         @default(NEW)
  source          LeadSource        @default(WHATSAPP)
  // Intermediación: si el contacto quiere comprar o vender, qué tan listo está y lo que ya respondió
  leadType        LeadType          @default(BUYER)
  temperature     LeadTemperature?
  qualification   Json? // { busca, presupuesto, formaPago, partePago, zona, plazo }
  aiSummary       String? // resumen para el asesor
  offerCop        BigInt? // última oferta del comprador, en pesos
  listingId       String? // bien que le interesa o que quiere vender
  // Lo que busca, en datos que se pueden cruzar con el inventario (los llena la IA o el asesor)
  searchKind      ListingKind?
  searchOperation ListingOperation?
  budgetMaxCop    BigInt?
  searchCity      String?
  lastContactAt   DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  listing      Listing?       @relation(fields: [listingId], references: [id], onDelete: SetNull)
  openers      LeadOpener[]
  appointments Appointment[]
  matches      ListingMatch[]

  @@index([tenantId, stage])
  @@map("leads")
}

enum LeadStage {
  NEW // recién captado
  CONTACTED // primer contacto enviado
  INTERESTED // mostró interés
  READY_TO_BUY // listo para comprar
  CUSTOMER // ya es cliente
  LOST // perdido
}

enum LeadType {
  BUYER
  SELLER
}

enum LeadTemperature {
  HOT // tiene con qué y quiere ver o cerrar pronto
  WARM // interesado, le falta definir algo
  COLD // solo está mirando
}

enum LeadSource {
  WHATSAPP
  REFERRAL
  IMPORT
  MANUAL
  OTHER
}

// Mensaje "abridor" generado por IA para captar leads — guardamos
// el contenido y métricas para ver cuál convierte más.
model LeadOpener {
  id          String    @id @default(cuid())
  leadId      String
  content     String
  generatedBy String    @default("ai")
  sentAt      DateTime?
  responded   Boolean   @default(false)
  convertedAt DateTime?
  createdAt   DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_openers")
}

// ============================================================================
// PEDIDOS / ORDENES
// ============================================================================

model Order {
  id                  String      @id @default(cuid())
  tenantId            String
  clientId            String
  code                String // ej: ORD-000123
  status              OrderStatus @default(PENDING_PAYMENT)
  totalCents          Int
  currency            String      @default("COP")
  paymentProofUrl     String?
  paidAt              DateTime?
  scheduledDeliveryAt DateTime?
  dispatchedAt        DateTime?
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  items  OrderItem[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("orders")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  AWAITING_DISPATCH
  DISPATCHED
  COMPLETED
  CANCELLED
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String?
  productNameSnap String // snapshot del nombre por si el producto cambia
  unitPriceCents  Int
  quantity        Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// ============================================================================
// CONVERSACIONES / WHATSAPP
// ============================================================================

model Conversation {
  id            String             @id @default(cuid())
  tenantId      String
  clientId      String?
  waChatId      String // wa_id (teléfono cliente)
  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime?
  unreadCount   Int                @default(0)
  assignedTo    String? // userId del agente asignado
  aiPausedUntil DateTime? // la IA no responde hasta esta fecha (se pasó a una persona)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client   Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([tenantId, waChatId])
  @@index([tenantId, status])
  @@map("conversations")
}

enum ConversationStatus {
  OPEN
  PENDING_REVIEW
  CLOSED
  ARCHIVED
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  waMessageId    String?          @unique
  direction      MessageDirection
  type           MessageType      @default(TEXT)
  content        String
  mediaUrl       String?
  authoredBy     MessageAuthor    @default(CLIENT)
  agentUserId    String?
  sentAt         DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@map("messages")
}

/// Registro de uso de IA por turno de respuesta. Permite ver cuántos tokens
/// y cuánto costo (estimado) consume cada conversación / tenant.
model AiUsageLog {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  provider       String // "openai" | "gemini"
  model          String // modelo concreto (ej: gpt-4o-mini)
  tokensIn       Int
  tokensOut      Int
  toolCalls      Int      @default(0)
  costMicroUsd   Int      @default(0) // costo estimado en millonésimas de USD
  intent         String? // a qué agente lo envió el router (ventas, pedido, info, humano)
  trace          Json? // pasos del grafo: nodos, herramientas, argumentos y verificación
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([conversationId])
  @@map("ai_usage_logs")
}

/// Ajustes de toda la plataforma que su dueño cambia desde /plataforma (por ejemplo, el modelo del agente)
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  TEMPLATE
}

enum MessageAuthor {
  CLIENT
  AGENT
  AI
  SYSTEM
}

// ============================================================================
// PLANTILLAS DE MENSAJES
// ============================================================================

model MessageTemplate {
  id        String           @id @default(cuid())
  tenantId  String
  key       String // ej: "welcome", "order_confirmation"
  name      String
  body      String
  category  TemplateCategory @default(CUSTOM)
  variables String[] // ej: ["{{cliente}}", "{{total}}"]
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("message_templates")
}

enum TemplateCategory {
  WELCOME
  ORDER_CONFIRMATION
  PAYMENT_REMINDER
  DISPATCH
  RECOVERY
  CUSTOM
}

// ============================================================================
// INTEGRACIÓN WHATSAPP
// ============================================================================

model WhatsappAccount {
  id                 String @id @default(cuid())
  tenantId           String @unique
  // Proveedor de mensajería de esta cuenta: "meta" | "twilio".
  // (Baileys no persiste cuenta: usa sesión en disco.)
  provider           String @default("meta")
  // Número de WhatsApp del negocio en formato E.164 sin '+' (solo dígitos).
  // Lo comparten Meta y Twilio; en Twilio se usa como remitente y para
  // resolver el tenant en el webhook entrante.
  displayPhoneNumber String

  // --- Meta Cloud API (solo si provider="meta") ---
  phoneNumberId      String? // de Meta
  businessAccountId  String?
  accessTokenEnc     String? // cifrado en reposo (TODO)
  webhookVerifyToken String?

  // --- Twilio (solo si provider="twilio") ---
  twilioAccountSid   String?
  twilioAuthTokenEnc String? // cifrado en reposo (TODO)

  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_accounts")
}

// ============================================================================
// REGLAS DE LA IA (editables por el negocio)
// ============================================================================

// Reglas de negocio que la IA sigue al responder. Viven en la base de datos para que el
// negocio las cambie sin tocar código. Las instrucciones técnicas (cómo usar cada
// herramienta) siguen en el código.
model AiRule {
  id        String         @id @default(cuid())
  tenantId  String
  category  AiRuleCategory
  title     String
  content   String
  isActive  Boolean        @default(true)
  position  Int            @default(0)
  // Identifica las reglas que vienen por defecto, para poder restaurarlas
  systemKey String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, systemKey])
  @@index([tenantId, isActive])
  @@map("ai_rules")
}

enum AiRuleCategory {
  POLICY // lo que la IA puede y no puede decir o hacer
  QUALIFICATION // preguntas para calificar al cliente
  HANDOFF // cuándo pasar la conversación a una persona
  TONE // trato y estilo
}

// ============================================================================
// INVENTARIO DE BIENES (intermediación)
// ============================================================================

model Listing {
  id           String           @id @default(cuid())
  tenantId     String
  code         String // INV-0001
  kind         ListingKind
  operation    ListingOperation @default(SALE)
  title        String
  description  String?
  priceCop     BigInt // pesos colombianos (un inmueble no cabe en Int de centavos)
  city         String
  zone         String? // barrio o sector: lo único de la ubicación que ve el comprador
  attributes   Json? // { "Año": "2021", "Kilometraje": "48.000 km" } o { "Área": "72 m²", "Habitaciones": "3" }
  photos       String[]
  status       ListingStatus    @default(AVAILABLE)
  // Datos privados: la IA nunca los recibe
  ownerName    String?
  ownerPhone   String?
  exactAddress String?
  privateNotes String?
  // Id del bien en la fuente externa (Excel, Google Sheets, base de datos) para actualizarlo al sincronizar
  externalId   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads        Lead[]
  appointments Appointment[]
  matches      ListingMatch[]

  @@unique([tenantId, code])
  @@unique([tenantId, externalId])
  @@index([tenantId, status])
  @@map("listings")
}

enum ListingKind {
  VEHICLE
  PROPERTY
  OTHER
}

enum ListingOperation {
  SALE
  RENT
}

enum ListingStatus {
  PENDING_REVIEW // lo trajo un vendedor por WhatsApp y falta aprobarlo
  AVAILABLE
  RESERVED
  SOLD
  ARCHIVED
}

// Visitas y pruebas de manejo que pide el comprador; un asesor confirma la hora
model Appointment {
  id                    String            @id @default(cuid())
  tenantId              String
  clientId              String?
  leadId                String?
  listingId             String?
  requestedSlot         String // lo que pidió el cliente: "jueves en la mañana"
  scheduledAt           DateTime? // la hora que confirma el asesor (o que agenda la IA si hay calendario conectado)
  durationMin           Int               @default(60)
  status                AppointmentStatus @default(REQUESTED)
  notes                 String?
  // Evento en el calendario externo (Google Calendar u otro proveedor)
  calendarProvider      String?
  calendarEventId       String?
  calendarEventUrl      String?
  // Calendario donde quedó el evento (el del negocio o el de un asesor)
  calendarIntegrationId String?
  // Asesor que atiende la cita (el dueño del calendario donde se agendó, o el que asigne el panel)
  assignedUserId        String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calendarIntegration Integration? @relation(fields: [calendarIntegrationId], references: [id], onDelete: SetNull)
  assignedUser        User?        @relation("AssignedAppointments", fields: [assignedUserId], references: [id], onDelete: SetNull)
  client              Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead                Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  listing             Listing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)
  reminders           Reminder[]

  @@index([tenantId, status])
  @@map("appointments")
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  DONE
  CANCELLED
}

// Coincidencia entre un bien que entró al inventario y un comprador que busca algo así.
// Se crea al publicar el bien; el asesor la aprueba (o sale sola en modo AUTO) y se le escribe al cliente.
model ListingMatch {
  id        String      @id @default(cuid())
  tenantId  String
  listingId String
  leadId    String
  score     Int
  reasons   String // por qué coincide, para el asesor: "busca vehículo · presupuesto hasta $100.000.000"
  message   String // mensaje sugerido; el asesor lo puede editar antes de enviar
  status    MatchStatus @default(PENDING)
  error     String?
  decidedBy String? // userId del asesor que aprobó o descartó
  sentAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([listingId, leadId])
  @@index([tenantId, status])
  @@map("listing_matches")
}

enum MatchStatus {
  PENDING // esperando aprobación del asesor
  SENT
  DISMISSED
  FAILED
}

// ============================================================================
// INTEGRACIONES (calendario, hojas de cálculo…): una conexión por proveedor y negocio.
// Los agentes no conocen el proveedor: usan los puertos del módulo integrations.
// ============================================================================

model Integration {
  id              String              @id @default(cuid())
  tenantId        String
  provider        IntegrationProvider
  // De quién es la conexión: "business" (la del negocio: calendario compartido y hojas de cálculo)
  // o "user:<userId>" (el calendario propio de un asesor). Texto y no null para que la llave única funcione.
  ownerKey        String              @default("business")
  // Asesor dueño de la conexión; null si es la del negocio
  userId          String?
  status          IntegrationStatus   @default(CONNECTED)
  accountEmail    String?
  scopes          String[]
  accessTokenEnc  String? // cifrado con SECRETS_ENCRYPTION_KEY
  refreshTokenEnc String?
  expiresAt       DateTime?
  // Google: { calendarId, timeZone, workDays, dayStart, dayEnd, slotMinutes, minNoticeHours, acceptsVisits }
  settings        Json?
  lastError       String?
  connectedBy     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([tenantId, provider, ownerKey])
  @@index([tenantId, provider])
  @@map("integrations")
}

// Credenciales OAuth propias de un negocio (su propio proyecto de Google Cloud). Si no hay, se usan
// las de la plataforma (variables de entorno). El secreto va cifrado.
model IntegrationApp {
  id              String              @id @default(cuid())
  tenantId        String
  provider        IntegrationProvider
  clientId        String
  clientSecretEnc String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@map("integration_apps")
}

enum IntegrationProvider {
  GOOGLE
}

enum IntegrationStatus {
  CONNECTED
  ERROR // el token venció o se revocó: hay que reconectar
  DISCONNECTED
}

// Fuentes de datos que alimentan productos, inventario o clientes: un archivo subido una vez,
// una hoja de Google o una base de datos externa que se sincroniza cada cierto tiempo.
model DataSource {
  id               String         @id @default(cuid())
  tenantId         String
  name             String
  type             DataSourceType
  target           ImportTarget
  // FILE: { fileName } · GOOGLE_SHEET: { spreadsheetId, sheetName } · POSTGRES/MYSQL: { table }
  config           Json
  secretEnc        String? // URL de conexión a la base externa, cifrada
  mapping          Json // { campoDestino: "Columna de la fuente" }
  syncEveryMinutes Int? // null = solo manual
  isActive         Boolean        @default(true)
  lastSyncAt       DateTime?
  lastStatus       SyncStatus?
  lastResult       Json? // { created, updated, skipped, errors: [...] }
  lastError        String?
  createdBy        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("data_sources")
}

enum DataSourceType {
  FILE
  GOOGLE_SHEET
  POSTGRES
  MYSQL
}

enum ImportTarget {
  PRODUCTS
  LISTINGS
  CLIENTS
}

enum SyncStatus {
  OK
  PARTIAL // algunas filas no se pudieron importar
  ERROR
}

// ============================================================================
// FECHAS ESPECIALES, RED DE CONTACTOS Y FELICITACIONES
// ============================================================================

model ClientDate {
  id         String         @id @default(cuid())
  tenantId   String
  clientId   String
  kind       ClientDateKind
  label      String? // "Aniversario de bodas", "Compró su apartamento"
  // Si la fecha es de otra persona de su círculo: "María (esposa)". El mensaje le llega al cliente.
  personName String?
  month      Int
  day        Int
  year       Int?
  // Mensaje propio para esta fecha; si no hay, se usa la plantilla del negocio
  message    String?
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  greetings Greeting[]

  @@index([tenantId, month, day])
  @@index([clientId])
  @@map("client_dates")
}

enum ClientDateKind {
  BIRTHDAY
  ANNIVERSARY
  CUSTOM
}

// Red de contactos: quién refirió a quién, familiares, socios… entre clientes del negocio.
model ClientRelation {
  id              String   @id @default(cuid())
  tenantId        String
  clientId        String
  relatedClientId String
  label           String // cómo se relaciona el segundo con el primero: "Esposa", "Lo refirió", "Socio"
  createdAt       DateTime @default(now())

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client  Client @relation("ClientRelations", fields: [clientId], references: [id], onDelete: Cascade)
  related Client @relation("ClientRelatedTo", fields: [relatedClientId], references: [id], onDelete: Cascade)

  @@unique([clientId, relatedClientId])
  @@index([tenantId])
  @@map("client_relations")
}

model Greeting {
  id           String      @id @default(cuid())
  tenantId     String
  clientId     String
  clientDateId String
  occursOn     DateTime    @db.Date
  message      String
  status       MatchStatus @default(PENDING)
  error        String?
  decidedBy    String?
  sentAt       DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientDate ClientDate @relation(fields: [clientDateId], references: [id], onDelete: Cascade)

  @@unique([clientDateId, occursOn])
  @@index([tenantId, status])
  @@map("greetings")
}

// Recordatorios (además de las felicitaciones, que van en Greeting):
// - APPOINTMENT: se le escribe al cliente antes de su cita para confirmarla.
// - FOLLOW_UP: el cliente dejó de responder; se le escribe una vez para retomar.
// - CUSTOM: lo programa el asesor. Con autoSend sale al cliente a la hora; sin él es una tarea del equipo.
// Igual que las felicitaciones: quedan para aprobar o salen solos según la configuración del negocio.
model Reminder {
  id             String       @id @default(cuid())
  tenantId       String
  clientId       String
  kind           ReminderKind
  dueAt          DateTime
  message        String
  // Nota interna para el equipo (lo que hay que hacer, por qué se programó)
  note           String?
  // CUSTOM: true = el mensaje sale solo al cliente a la hora; false = tarea para el equipo
  autoSend       Boolean      @default(false)
  status         MatchStatus  @default(PENDING)
  error          String?
  appointmentId  String?
  // Hora de la cita cuando se creó el recordatorio: si la cita se mueve, este se descarta y se crea otro
  appointmentAt  DateTime?
  conversationId String?
  // Seguimiento: último mensaje del cliente antes del silencio (un solo seguimiento por silencio)
  sourceAt       DateTime?
  createdBy      String?
  decidedBy      String?
  notifiedAt     DateTime?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, appointmentAt])
  @@unique([conversationId, sourceAt])
  @@index([tenantId, status, dueAt])
  @@map("reminders")
}

enum ReminderKind {
  APPOINTMENT
  FOLLOW_UP
  CUSTOM
}

// ============================================================================
// VOZ DEL AGENTE
// ============================================================================

// Cómo usa la voz el agente: entender las notas de voz de los clientes y responder con voz.
// Si el negocio no tiene fila, rigen los valores por defecto (solo transcribir).
model AgentVoice {
  id                String         @id @default(cuid())
  tenantId          String         @unique
  // Transcribe las notas de voz que mandan los clientes para que el agente las lea
  transcribeInbound Boolean        @default(true)
  // Responde con notas de voz según `mode`
  enabled           Boolean        @default(false)
  provider          VoiceProvider  @default(GEMINI)
  // Voz de Gemini (Kore, Puck…) o id de voz de ElevenLabs (prediseñada o clonada)
  voiceId           String         @default("Kore")
  voiceName         String?
  // Tono con que habla: "cálido y cercano, con acento colombiano"
  style             String?
  mode              VoiceReplyMode @default(MIRROR)
  // Modo RULES: cuándo responder con voz, en palabras del negocio; las evalúa el router
  rules             String[]       @default([])
  // Especialistas que pueden responder con voz; vacío = todos
  intents           String[]       @default([])
  // Respuestas más largas van por texto
  maxSeconds        Int            @default(40)
  // Si la respuesta trae precios, enlaces o códigos, también se manda por texto
  textForData       Boolean        @default(true)
  // Manda siempre el texto debajo del audio
  alsoSendText      Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("agent_voices")
}

enum VoiceProvider {
  GEMINI
  ELEVENLABS
}

enum VoiceReplyMode {
  MIRROR // responde con voz cuando el cliente manda una nota de voz
  RULES // según las reglas del negocio
  ALWAYS
}

// Voces clonadas por el negocio en ElevenLabs. La cuenta de ElevenLabs es de la plataforma,
// así que cada negocio solo ve y usa las suyas.
model ClonedVoice {
  id              String   @id @default(cuid())
  tenantId        String
  providerVoiceId String   @unique
  name            String
  // Quién confirmó tener la autorización de la persona dueña de la voz
  consentById     String
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("cloned_voices")
}

// Audios de las conversaciones (notas de voz del cliente y del agente) para escucharlos en el panel
model VoiceClip {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String?
  mimeType       String
  seconds        Float?
  data           Bytes
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("voice_clips")
}
