// whatsAppia - CRM multi-tenant por WhatsApp
// Schema modelo: todas las entidades de negocio incluyen tenantId
// para aislamiento por negocio. RBAC granular con permisos por recurso.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// PLATAFORMA (sin tenantId — globales)
// ============================================================================

model Tenant {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  industry      String?
  address       String?
  taxId         String?
  description   String?
  status        TenantStatus @default(ACTIVE)
  aiAutoReply   Boolean      @default(false)
  aiAgentName   String?
  // Contexto que usa el agente de IA para responder (texto libre que escribe el negocio)
  businessHours String? // horario de atención
  deliveryInfo  String? // envíos, cobertura, costos y tiempos
  paymentInfo   String? // medios de pago
  faq           String? // preguntas frecuentes, políticas de cambios y garantías
  // Consecutivo de pedidos (se incrementa dentro de la transacción)
  orderSeq      Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  memberships     Membership[]
  roles           Role[]
  products        Product[]
  templates       MessageTemplate[]
  clients         Client[]
  leads           Lead[]
  orders          Order[]
  conversations   Conversation[]
  whatsappAccount WhatsappAccount?

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

// Usuario global de la plataforma — puede pertenecer a varios tenants
model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  passwordHash    String
  avatarUrl       String?
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships Membership[]

  @@map("users")
}

// Relación N:M User<->Tenant con rol(es) por tenant
model Membership {
  id        String           @id @default(cuid())
  userId    String
  tenantId  String
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles  MembershipRole[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

// ============================================================================
// RBAC
// ============================================================================

model Role {
  id          String   @id @default(cuid())
  tenantId    String? // null = rol del sistema, no editable
  key         String // ej: "owner", "admin", "agent", "viewer"
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id        String   @id @default(cuid())
  key       String   @unique // ej: "products.create", "orders.update"
  resource  String // "products", "orders", ...
  action    String // "create", "read", "update", "delete", "manage"
  createdAt DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String
  roleId       String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@map("membership_roles")
}

// ============================================================================
// PRODUCTOS / CATÁLOGO
// ============================================================================

model Product {
  id             String        @id @default(cuid())
  tenantId       String
  sku            String?
  name           String
  description    String?
  priceCents     Int // siempre en centavos, evita float
  currency       String        @default("COP")
  trackInventory Boolean       @default(true)
  stock          Int           @default(0)
  imageUrl       String?
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@map("products")
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

// ============================================================================
// CLIENTES / LEADS (CRM)
// ============================================================================

model Client {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String // E.164
  email     String?
  address   String?
  notes     String?
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads         Lead[]
  orders        Order[]
  conversations Conversation[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("clients")
}

model Lead {
  id              String     @id @default(cuid())
  tenantId        String
  clientId        String?
  contactName     String
  businessName    String?
  phone           String
  address         String?
  industry        String?
  productInterest String?
  reasonNotBought String?
  stage           LeadStage  @default(NEW)
  source          LeadSource @default(WHATSAPP)
  lastContactAt   DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client  Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  openers LeadOpener[]

  @@index([tenantId, stage])
  @@map("leads")
}

enum LeadStage {
  NEW // recién captado
  CONTACTED // primer contacto enviado
  INTERESTED // mostró interés
  READY_TO_BUY // listo para comprar
  CUSTOMER // ya es cliente
  LOST // perdido
}

enum LeadSource {
  WHATSAPP
  REFERRAL
  IMPORT
  MANUAL
  OTHER
}

// Mensaje "abridor" generado por IA para captar leads — guardamos
// el contenido y métricas para ver cuál convierte más.
model LeadOpener {
  id          String    @id @default(cuid())
  leadId      String
  content     String
  generatedBy String    @default("ai")
  sentAt      DateTime?
  responded   Boolean   @default(false)
  convertedAt DateTime?
  createdAt   DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_openers")
}

// ============================================================================
// PEDIDOS / ORDENES
// ============================================================================

model Order {
  id                  String      @id @default(cuid())
  tenantId            String
  clientId            String
  code                String // ej: ORD-000123
  status              OrderStatus @default(PENDING_PAYMENT)
  totalCents          Int
  currency            String      @default("COP")
  paymentProofUrl     String?
  paidAt              DateTime?
  scheduledDeliveryAt DateTime?
  dispatchedAt        DateTime?
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  items  OrderItem[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("orders")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  AWAITING_DISPATCH
  DISPATCHED
  COMPLETED
  CANCELLED
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String?
  productNameSnap String // snapshot del nombre por si el producto cambia
  unitPriceCents  Int
  quantity        Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// ============================================================================
// CONVERSACIONES / WHATSAPP
// ============================================================================

model Conversation {
  id            String             @id @default(cuid())
  tenantId      String
  clientId      String?
  waChatId      String // wa_id (teléfono cliente)
  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime?
  unreadCount   Int                @default(0)
  assignedTo    String? // userId del agente asignado
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client   Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([tenantId, waChatId])
  @@index([tenantId, status])
  @@map("conversations")
}

enum ConversationStatus {
  OPEN
  PENDING_REVIEW
  CLOSED
  ARCHIVED
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  waMessageId    String?          @unique
  direction      MessageDirection
  type           MessageType      @default(TEXT)
  content        String
  mediaUrl       String?
  authoredBy     MessageAuthor    @default(CLIENT)
  agentUserId    String?
  sentAt         DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@map("messages")
}

/// Registro de uso de IA por turno de respuesta. Permite ver cuántos tokens
/// y cuánto costo (estimado) consume cada conversación / tenant.
model AiUsageLog {
  id             String   @id @default(cuid())
  tenantId       String
  conversationId String
  provider       String // "openai" | "gemini"
  model          String // modelo concreto (ej: gpt-4o-mini)
  tokensIn       Int
  tokensOut      Int
  toolCalls      Int      @default(0)
  costMicroUsd   Int      @default(0) // costo estimado en millonésimas de USD
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([conversationId])
  @@map("ai_usage_logs")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  TEMPLATE
}

enum MessageAuthor {
  CLIENT
  AGENT
  AI
  SYSTEM
}

// ============================================================================
// PLANTILLAS DE MENSAJES
// ============================================================================

model MessageTemplate {
  id        String           @id @default(cuid())
  tenantId  String
  key       String // ej: "welcome", "order_confirmation"
  name      String
  body      String
  category  TemplateCategory @default(CUSTOM)
  variables String[] // ej: ["{{cliente}}", "{{total}}"]
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("message_templates")
}

enum TemplateCategory {
  WELCOME
  ORDER_CONFIRMATION
  PAYMENT_REMINDER
  DISPATCH
  RECOVERY
  CUSTOM
}

// ============================================================================
// INTEGRACIÓN WHATSAPP
// ============================================================================

model WhatsappAccount {
  id                 String @id @default(cuid())
  tenantId           String @unique
  // Proveedor de mensajería de esta cuenta: "meta" | "twilio".
  // (Baileys no persiste cuenta: usa sesión en disco.)
  provider           String @default("meta")
  // Número de WhatsApp del negocio en formato E.164 sin '+' (solo dígitos).
  // Lo comparten Meta y Twilio; en Twilio se usa como remitente y para
  // resolver el tenant en el webhook entrante.
  displayPhoneNumber String

  // --- Meta Cloud API (solo si provider="meta") ---
  phoneNumberId      String? // de Meta
  businessAccountId  String?
  accessTokenEnc     String? // cifrado en reposo (TODO)
  webhookVerifyToken String?

  // --- Twilio (solo si provider="twilio") ---
  twilioAccountSid   String?
  twilioAuthTokenEnc String? // cifrado en reposo (TODO)

  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_accounts")
}
