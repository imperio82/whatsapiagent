# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsappia?schema=public"

# Auth.js v5
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# WhatsApp provider: "baileys" (dev), "twilio" (pre/producción) o "meta" (producción)
WHATSAPP_PROVIDER="baileys"

# Carpeta donde Baileys guarda las credenciales de sesión por tenant.
# Solo aplica si WHATSAPP_PROVIDER=baileys.
BAILEYS_AUTH_DIR=".whatsapp-sessions"

# WhatsApp Cloud API (Meta). Solo se usa si WHATSAPP_PROVIDER=meta.
# Las credenciales (Phone Number ID, token de acceso) se guardan POR TENANT
# desde Configuración → WhatsApp; no van en .env. Estas vars son del webhook:
#   WHATSAPP_WEBHOOK_VERIFY_TOKEN → texto que inventás y pegás también en Meta.
#   WHATSAPP_APP_SECRET → App Secret de tu app (Configuración → Básica); valida la firma.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Llave para cifrar en reposo los tokens de Meta y Twilio (AES-256-GCM).
# 32 bytes en base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=""

# Twilio (WhatsApp). Solo se usa si WHATSAPP_PROVIDER=twilio.
# Las credenciales (Account SID, Auth Token, número From) se guardan POR TENANT
# desde Configuración → WhatsApp; no van en .env. Estas vars solo controlan la
# validación de la firma del webhook entrante:
#   TWILIO_VALIDATE_SIGNATURE=true  → valida X-Twilio-Signature (recomendado en prod).
#   En el sandbox se suele dejar en "false" mientras se prueba con ngrok.
TWILIO_VALIDATE_SIGNATURE="false"
# Opcional: fuerza la URL pública exacta que Twilio usó para firmar (si hay proxy/CDN).
# Ej: https://tu-dominio.com/api/v1/whatsapp/twilio/webhook
TWILIO_WEBHOOK_URL=""

# Proveedor de IA: "openai" o "gemini" (default: openai)
AI_PROVIDER="openai"

# OpenAI (si AI_PROVIDER=openai)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Google Gemini (si AI_PROVIDER=gemini)
# Obtené la API key en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
# Modelo del grafo multiagente (rápido para WhatsApp). Si se elige uno en /plataforma, manda el de ahí
GEMINI_GRAPH_MODEL="gemini-flash-lite-latest"

# Motor de respuesta: "graph" (router + especialistas + verificador, por defecto) o "simple" (un solo agente)
AI_ENGINE="graph"
# Espera (ms) sin mensajes nuevos antes de responder, para agrupar mensajes seguidos. "0" = responder de inmediato
AI_REPLY_DELAY_MS="6000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Google (Calendar para agendar visitas y Sheets para sincronizar datos). Guía: docs/INTEGRACION-GOOGLE.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bases de datos externas (Fuentes de datos): en producción se bloquean servidores de redes privadas.
# Ponlo en true solo si la base del cliente está en una red privada a la que este servidor sí debe llegar.
ALLOW_PRIVATE_DATA_SOURCES=false

# Tareas programadas (felicitaciones y sincronización de fuentes). true para apagarlas.
SCHEDULER_DISABLED=false

# Plataforma (/plataforma): correos que pueden entrar, separados por coma. Además deben tener la marca de
# administrador (npm run admin:grant -- correo). Sin esta variable no entra nadie.
PLATFORM_ADMIN_EMAILS=
# Pesos por dólar para pasar a pesos el costo de IA en la plataforma
USD_COP_RATE=3185

# Voz del agente (Administración → Voz del agente). Usa GEMINI_API_KEY para transcribir y para las voces incluidas.
# Modelo de voz de Gemini (el más barato con buena voz en español) y modelo que escucha los audios de los clientes
GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"
# Se usa si el anterior falla o se queda sin cupo (el plan gratuito de Gemini permite pocos audios al día)
GEMINI_TTS_FALLBACK_MODEL="gemini-3.8-flash-tts"
GEMINI_TRANSCRIBE_MODEL="gemini-flash-lite-latest"
# Voces premium y clonación de voz (opcional). La cuenta es de la plataforma; cada negocio solo ve sus voces clonadas.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL="eleven_flash_v2_5"
# Precio para el presupuesto: USD por cada 1.000 caracteres
ELEVENLABS_USD_PER_1K_CHARS=0.04
